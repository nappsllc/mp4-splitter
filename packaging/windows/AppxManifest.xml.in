<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. msix.ps1 fills in the @...@ values: the identity
     comes from Partner Center (see docs/STORES.md), the version from Cargo.toml. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>PowerNapps MP4 Splitter</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Tiny tool that cuts MP4 videos into pieces without re-encoding</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <!-- One <Resource> per lang/<tag>.txt, en-us first (the default); msix.ps1
       fills them in. The Store lists these as the app's languages. -->
  <Resources>
@RESOURCES@
  </Resources>
  <Applications>
    <Application Id="MP4Splitter" Executable="mp4-splitter.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="PowerNapps MP4 Splitter" Description="Cut MP4 videos into pieces without re-encoding"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="mp4-splitter.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="mp4-splitter.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <!-- runFullTrust: a desktop app, reading and writing the videos the user picks.
       No internet capability: this build never looks for updates, the Store sees
       to them. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
